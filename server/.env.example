# Copia este ficheiro para ".env" e preenche os valores.
#
# Em desenvolvimento local, podes deixar tudo por preencher — sem
# TURSO_DATABASE_URL definido, o servidor usa automaticamente um ficheiro
# SQLite local (server/data/banco.db).
#
# Em produção (ex.: Render), define estas variáveis no dashboard do serviço
# com os valores da tua base de dados Turso (dashboard.turso.tech ou `turso
# db show <nome> --url` / `turso db tokens create <nome>`).

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# A maioria dos serviços de alojamento (Render incluído) define isto sozinha
# — não precisas de mexer aqui.
PORT=4001
